{
  "name": "@publisle/adapter-astro",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "publisle",
    "publication",
    "portable-documents"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Article.astro": "./src/Article.astro",
    "./runtime": "./src/runtime.ts"
  },
  "dependencies": {
    "@publisle/adapter-core": "workspace:^",
    "@publisle/schema": "workspace:^"
  },
  "peerDependencies": {
    "astro": "^7.2.8"
  },
  "devDependencies": {
    "astro": "^7.2.8"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./Article.astro": "./dist/Article.astro",
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js",
        "default": "./dist/runtime.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publisle/publisle.git",
    "directory": "packages/adapter-astro"
  },
  "homepage": "https://github.com/publisle/publisle#readme"
}
