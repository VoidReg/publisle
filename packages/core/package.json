{
  "name": "@publisle/core",
  "version": "0.1.2",
  "description": "Preparation, validation, migration, and planning for Publisle documents.",
  "license": "MIT",
  "keywords": [
    "publisle",
    "preparation",
    "validation",
    "portable-documents",
    "publishing"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./hash": "./src/hash.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dependencies": {
    "@publisle/schema": "workspace:^"
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./hash": {
        "types": "./dist/hash.d.ts",
        "import": "./dist/hash.js",
        "default": "./dist/hash.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publisle/publisle.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/publisle/publisle#readme"
}
