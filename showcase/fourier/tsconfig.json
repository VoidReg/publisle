{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "astro.config.mjs"]
}
