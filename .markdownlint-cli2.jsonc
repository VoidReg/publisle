{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false,
  },
  "globs": [
    "README.md",
    "docs/**/*.md",
    "packages/*/README.md",
    "blocks/*/README.md",
  ],
  "ignores": ["**/node_modules/**", "**/dist/**"],
}
