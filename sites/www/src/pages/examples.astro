---
import { preparePublication } from "@publisle/adapter-astro";
import Article from "@publisle/adapter-astro/Article.astro";
import { fromMarkdown } from "@publisle/markdown";
import { coreBlockDefinitions } from "@publisle/blocks-core";
import { interactiveSchematicDefinition } from "@publisle/blocks-technical";
import { createRegistry } from "@publisle/core";
import demoSource from "../../content/demo-article.md?raw";
import BaseLayout from "../layouts/BaseLayout.astro";

const registry = createRegistry([
  ...coreBlockDefinitions,
  interactiveSchematicDefinition,
]);

const imported = fromMarkdown(demoSource, { sourceName: "demo-article.md" });
if (!imported.document) {
  throw new Error(
    imported.diagnostics
      .map((item) => `${item.code}: ${item.message}`)
      .join("\n"),
  );
}
const publication = preparePublication(imported.document, { registry });

const github = "https://github.com/VoidReg/publisle";
const demos = [  {
    title: "Fourier partial sums",
    body: "Interactive mathematics: a publication block that animates Fourier series convergence with typed island inputs.",
    href: "https://github.com/VoidReg/publisle/tree/main/showcase/fourier",
  },
  {
    title: "Interactive schematics",
    body: "Clocked digital-logic blocks with activation policies, accessible labels, and static fallbacks for print.",
    href: `${github}/tree/main/blocks/technical`,
  },
  {
    title: "Journal templates",
    body: "IEEE, ACM, Elsevier, and Springer LaTeX/PDF export profiles driven from the same portable document.",
    href: `${github}/tree/main/packages/research`,
  },
];
---

<BaseLayout
  title="Examples · Publisle"
  description="Live Publisle examples: a compiled article, interactive islands with static fallbacks, and journal export demos."
  path="/examples"
>
  <div class="py-12">
    <h1 class="font-display text-4xl font-bold">Examples</h1>
    <p class="mt-3 max-w-2xl text-muted">
      The article below is real Publisle output: compile, render, and style
      are all production paths. Edit its source in the{" "}
      <a class="text-accent hover:underline" href="/playground">playground</a>.
    </p>

    <p class="mt-3 text-muted">
      Want a longer walkthrough?{" "}
      <a class="text-accent underline underline-offset-2" href="/playground?example=fft">Open the Fourier &amp; FFT article</a>{" "}
      with colored equations, a butterfly network, figures, code, citations, and an interactive transform.
    </p>

    <article
      class="publication-wide mt-8 rounded-xl border border-line bg-surface p-6 sm:p-8"
    >
      <Article publication={publication} instanceId="example-article" />
    </article>

    <section aria-labelledby="more-demos" class="mt-12 pb-16">
      <h2 id="more-demos" class="font-display text-2xl font-semibold">
        More demos in the repository
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          demos.map((demo) => (
            <a
              href={demo.href}
              class="block rounded-xl border border-line bg-surface p-5 transition hover:border-accent"
              rel="noopener"
            >
              <h3 class="font-display text-lg font-semibold">{demo.title}</h3>
              <p class="mt-2 text-sm text-muted">{demo.body}</p>
              <p class="mt-3 text-sm text-accent">View source →</p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
