---
import { getCollection } from "astro:content";
import DocsSearch from "../../components/DocsSearch.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await getCollection("docs");
const bySection = (section: string) =>
  entries
    .filter((entry) => entry.data.section === section)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const guides = bySection("guides");
const standards = bySection("standards");

const entryHref = (id: string) => `/docs/${id === "standards" ? "standards" : id}`;
---

<BaseLayout
  title="Documentation · Publisle"
  description="Guides and standards for Publisle: portable contracts, framework hosts, accessibility, and release engineering. Compiled by Publisle itself."
  path="/docs/"
>
  <div class="py-12">
    <h1 class="font-display text-4xl font-bold">Documentation</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Every page below is authored as Markdown, loaded through Publisle's
      content pipeline, and rendered by the production compiler. The
      documentation is the demo.
    </p>

    <DocsSearch client:load />

    <section aria-labelledby="guides" class="mt-12">
      <h2 id="guides" class="font-display text-2xl font-semibold">Guides</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          guides.map((entry) => (
            <li>
              <a
                href={entryHref(entry.id)}
                class="block rounded-lg border border-line bg-surface p-4 transition hover:border-accent"
              >
                <span class="font-medium">{entry.data.title}</span>
                <span class="mt-1 block text-sm text-muted">
                  /docs/{entry.id}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="standards" class="mt-12">
      <h2 id="standards" class="font-display text-2xl font-semibold">
        Standards
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          standards.map((entry) => (
            <li>
              <a
                href={entryHref(entry.id)}
                class="block rounded-lg border border-line bg-surface p-4 transition hover:border-accent"
              >
                <span class="font-medium">{entry.data.title}</span>
                <span class="mt-1 block text-sm text-muted">
                  /docs/{entry.id === "standards" ? "standards" : entry.id}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
