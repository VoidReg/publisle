---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coreBlockDefinitions } from "@publisle/blocks-core";
import { createRegistry } from "@publisle/core";
import { fromMarkdown } from "@publisle/markdown";
import { preparePublication } from "@publisle/adapter-astro";
import Article from "@publisle/adapter-astro/Article.astro";
import FftShowcase from "../components/FftShowcase.svelte";
import performance from "../data/performance.json";
const publisleMeasurement = performance.tools.find(tool => tool.name === "Publisle");

const heroMarkdown = `## Small signals, clear results

The transform in Equation :ref[eq\\:signal] turns samples into a spectrum.

:::equation{label="eq:signal"}
$$
X_k=\\sum_{n=0}^{N-1} x_n e^{-2\\pi i kn/N}
$$
:::

| Frequency bin | Magnitude |
| --- | --- |
| 2 | 4 |
| 6 | 4 |

::::figure{src="/fft-spectrum.svg" label="fig:spectrum" alt="Eight frequency bins with magnitude four at bins two and six"}
:::caption
A signal becomes two clear peaks.
:::
::::
`;
const sample = fromMarkdown(heroMarkdown);
if (!sample.document) throw new Error("Invalid hero example");
const heroPublication = preparePublication(sample.document, { registry: createRegistry(coreBlockDefinitions) });

const github = "https://github.com/VoidReg/publisle";
const npmScope = "https://www.npmjs.com/org/publisle";

const formatBytes = (bytes: number) => bytes === 0 ? "0 B" : bytes < 1024 ? `${bytes} B` : bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KiB` : `${(bytes / 1024 / 1024).toFixed(1)} MiB`;
const features = [
  {title: "Math belongs in the article", body: "Build-time equations, numbered references, captioned figures, and tables. Real text and MathML, with a static reading experience."},
  {title: "Make the explanation interactive", body: "Give readers a working experiment. Load each interactive island when it is needed, with an authored explanation available before activation."},
  {title: "Take the same work to publication", body: "Export a research manuscript to LaTeX, JATS, or PDF, with IEEE, ACM, Elsevier, and Springer starter templates."},
];

const packages = coreBlockDefinitions.length >= 0
  ? [
      ["@publisle/core", "Document model, validation, static compilation"],
      ["@publisle/markdown", "Markdown import and export codecs"],
      ["@publisle/schema", "Portable document schema and diagnostics"],
      ["@publisle/adapter-astro", "Astro content loader and article renderer"],
      ["@publisle/adapter-svelte", "Svelte article components and runtime"],
      ["@publisle/cli", "Build, validate, and export from the terminal"],
    ]
  : [];
---

<BaseLayout
  title="Publisle · math, research, and interactive articles"
  description="Publish equations, research papers, and interactive explanations from Markdown or typed JSON. Static articles, live experiments, and optional journal exports."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Publisle",
        url: "https://publisle.xyz",
        description:
          "Portable semantic articles compiled into static HTML with typed interactive islands.",
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Publisle",
        url: "https://publisle.xyz",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Node.js 24+",
        description:
          "Publishing toolkit for technical articles, research papers, and interactive explanations: Markdown or JSON in, validated portable documents, static HTML out.",
        license: "https://github.com/VoidReg/publisle/blob/main/LICENSE",
        author: { "@type": "Organization", name: "VoidReg" },
      },
    ])}
  />

  <section class="grid items-center gap-8 py-10 lg:grid-cols-2 lg:py-14">
    <div class="min-w-0">
      <p class="mb-4 text-sm font-medium text-accent">Open source · Beta</p>
      <h1 class="text-balance font-display text-4xl font-bold sm:text-5xl">Math, research, and explanations that come alive.</h1>
      <p class="mt-5 max-w-xl text-lg text-muted">Write in Markdown. Publish a readable article, add a working experiment, and take the same document to a research manuscript.</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="/playground" class="rounded-lg bg-accent px-5 py-2.5 font-medium text-bg hover:opacity-90">Try the playground</a>
        <a href="/docs" class="rounded-lg border border-line px-5 py-2.5 font-medium hover:border-accent">Read the docs</a>
        <a href={github} class="text-sm text-accent underline underline-offset-2" rel="me noopener">Source on GitHub →</a>
      </div>
      <p class="mt-4 text-sm text-muted">The example is compiled by Publisle.</p>
    </div>
    <div class="publication-wide min-w-0 rounded-xl border border-line bg-raised p-5 sm:p-6" aria-label="Rendered article example">
      <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Markdown → published article</p>
      <Article publication={heroPublication} instanceId="hero-example" />
      <details class="mt-5 border-t border-line pt-3">
        <summary class="cursor-pointer text-sm font-medium text-accent">See the Markdown</summary>
        <pre class="mt-3 max-w-full overflow-x-auto text-xs"><code>{heroMarkdown}</code></pre>
      </details>
    </div>
  </section>

  <section class="grid gap-6 py-10 lg:grid-cols-2" aria-labelledby="explore">
    <div class="min-w-0">
      <h2 id="explore" class="font-display text-3xl font-semibold">From a readable page to a working idea.</h2>
      <p class="mt-4 text-muted">Readers get the article first. The experiment starts when they choose to explore. Your content stays readable without JavaScript.</p>
      <p class="mt-4 text-muted">For scholarly work, the same structured content carries its equations, references, figures, and bibliography into print.</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/playground/?example=research-paper" class="text-accent underline underline-offset-4">Edit the Research paper →</a>
        <a href="/examples/research-paper.pdf" class="text-accent underline underline-offset-4">Read its PDF ↗</a>
      </div>
    </div>
    <FftShowcase client:load />
  </section>

  <section aria-labelledby="performance" class="py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><p class="text-xs font-medium tracking-wide text-accent uppercase">Measured performance</p><h2 id="performance" class="mt-2 font-display text-3xl font-semibold">Put the work in the build. Keep the reader lean.</h2></div>
      <a href="/docs/guides/performance-comparison" class="text-sm text-accent underline underline-offset-4">Methodology and results →</a>
    </div>
    <p class="mt-4 max-w-3xl text-muted">Publisle compiles the document before it reaches your reader. Here is the same math-heavy document through popular publishing tools. Reader delivery is measured separately, with static hosts and default documentation themes identified.</p>
    {publisleMeasurement && <dl class="mt-7 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-line bg-raised p-5"><dt class="text-sm text-muted">20 displayed equations · warm compile</dt><dd class="mt-2 font-display text-3xl font-semibold">{publisleMeasurement.compileMs.toFixed(1)} ms</dd></div>
      <div class="rounded-xl border border-line bg-raised p-5"><dt class="text-sm text-muted">Static publication JavaScript</dt><dd class="mt-2 font-display text-3xl font-semibold">0 B</dd></div>
      <div class="rounded-xl border border-line bg-raised p-5"><dt class="text-sm text-muted">Installed Core CLI + dependencies</dt><dd class="mt-2 font-display text-3xl font-semibold">{formatBytes(publisleMeasurement.installedBytes)}</dd></div>
    </dl>}
    <div class="mt-6 max-w-full overflow-x-auto rounded-xl border border-line">
      <table class="w-full text-left text-sm">
        <caption class="p-4 text-left text-xs text-muted">{performance.samples} recorded samples per compiler after five warmups. Compilation uses twenty displayed equations plus inline math; reader JavaScript uses the separate prose/code article.</caption>
        <thead class="border-b border-line bg-raised"><tr><th class="p-4">Tool</th><th class="p-4">Math compilation · median</th><th class="p-4">Reader JS</th><th class="p-4">Installed tools</th></tr></thead>
        <tbody>{performance.tools.map((tool) => <tr class:list={["border-b border-line last:border-0", {"bg-raised":tool.name === "Publisle"}]}><th class="p-4 font-medium">{tool.name}<span class="mt-1 block text-xs font-normal text-muted">{tool.host}</span></th><td class="p-4">{tool.compileMs.toFixed(2)} ms<span class="block text-xs text-muted">{tool.operation}</span></td><td class="p-4 font-mono">{formatBytes(tool.readerJsGzipBytes)}</td><td class="p-4 font-mono">{formatBytes(tool.installedBytes)}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-muted">MDX and Pandoc can also publish static HTML without reader JavaScript. Docusaurus compilation here produces a module; its default site theme and VitePress include navigation and framework code. JavaScript compilers are warm; Pandoc includes process startup. Prose and large-document results are in the full report.</p>
  </section>

  <section aria-labelledby="features" class="py-16">
    <h2 id="features" class="font-display text-3xl font-semibold">
      One document, more ways to publish
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="rounded-xl border border-line bg-surface p-5">
            <h3 class="font-display text-lg font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm text-muted">{feature.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="quickstart" class="py-16">
    <h2 id="quickstart" class="font-display text-3xl font-semibold">
      Quickstart
    </h2>
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <p class="text-muted">
          Install the CLI and compile a document into a static reader page:
        </p>
        <pre
          class="mt-3 max-w-full overflow-x-auto rounded-lg border border-line bg-raised p-4 font-mono text-sm"><code>npm install -g @publisle/cli
publisle validate article.md
publisle build article.md --out dist/</code></pre>
        <p class="mt-3 text-sm text-muted">
          Journal exports (PDF, LaTeX, JATS) live in the optional research
          profile:{" "}
          <code
            class="rounded border border-line bg-raised px-1 font-mono text-xs"
            >npm install -g @publisle/cli-research</code
          >. See the{" "}
          <a class="text-accent hover:underline" href="/docs/guides/journal-export"
            >journal export guide</a
          >.
        </p>
      </div>
      <div class="min-w-0">
        <p class="text-muted">Or compile in-process with the Astro adapter:</p>
        <pre
          class="mt-3 max-w-full overflow-x-auto rounded-lg border border-line bg-raised p-4 font-mono text-sm"><code>import &#123; publisleLoader &#125; from "@publisle/adapter-astro";

export const collections = &#123;
  articles: defineCollection(&#123;
    loader: publisleLoader(
      &#123; local: "./article.json" &#125;,
      &#123; registry: createRegistry(coreBlockDefinitions) &#125;,
    ),
  &#125;),
&#125;;</code></pre>
      </div>
    </div>
  </section>

  <section aria-labelledby="packages" class="py-16 pb-24">
    <h2 id="packages" class="font-display text-3xl font-semibold">
      Published packages
    </h2>
    <p class="mt-2 text-muted">
      Independently versioned under the{" "}
      <a class="text-accent hover:underline" href={npmScope}>@publisle</a>
      {" "}npm scope. Core adopters never install research tooling.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        packages.map(([name, blurb]) => (
          <li class="rounded-lg border border-line bg-surface p-4">
            <a
              href={`https://www.npmjs.com/package/${name}`}
              class="font-mono text-sm font-medium text-accent hover:underline"
            >
              {name}
            </a>
            <p class="mt-1 text-sm text-muted">{blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
