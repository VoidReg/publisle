---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Publisle" path="/404">
  <div class="flex flex-col items-center py-32 text-center">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 font-display text-4xl font-bold">This page has no block.</h1>
    <p class="mt-3 max-w-md text-muted">
      The document you are looking for was not found. Try the docs, the
      examples, or the playground.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/docs" class="rounded-lg bg-accent px-5 py-2.5 font-medium text-bg hover:opacity-90">
        Documentation
      </a>
      <a
        href="/"
        class="rounded-lg border border-line bg-surface px-5 py-2.5 font-medium hover:border-accent hover:text-accent"
      >
        Home
      </a>
    </div>
  </div>
</BaseLayout>
